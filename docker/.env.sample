# Copy to .env (gitignored) in a *secondary* checkout to run a second stack in parallel.
#
# Leave this file uncopied in the main checkout: without a .env, the project name defaults
# to the directory name ("docker"), which is what the existing db-data volume with the
# loaded dump belongs to. Setting COMPOSE_PROJECT_NAME there would start from an empty
# database instead.

# Names the stack. Containers become <name>-db-1 / <name>-app-1 and the data volume
# becomes <name>_db-data, so nothing is shared with the main stack.
COMPOSE_PROJECT_NAME=ds2-hotfix

# Host ports. Must differ from whatever the other stack uses (8080/3306 by default).
DS_APP_PORT=8081
DS_DB_PORT=3307
